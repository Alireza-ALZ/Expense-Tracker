# ============================================================================
# Expense Tracker - .gitignore
# ============================================================================

# Supabase credentials (contains actual API keys)
# Each user must create their own config.js from config.example.js
config.js

# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini

# Editor / IDE files
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Node.js (in case dependencies are added in the future)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files
.env
.env.local
.env.*.local

# Log files
*.log